{
    "files": {
        "includes": ["**", "!**/dist", "!!**/build", "!!**/node_modules"]
    },
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "linter": {
        "rules": {
            "a11y": {
                "useMediaCaption": "off"
            }
        }
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 100
    }
}
